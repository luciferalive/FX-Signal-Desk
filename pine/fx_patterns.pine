//@version=5
// FX Patterns - chart patterns for TradingView (works on any pair, gold, oil and any timeframe).
// How to use: open a chart > "Pine Editor" at the bottom > "Open" > "New blank indicator" > delete everything >
// paste this whole file > "Add to chart". Add it next to the FX Signal Desk script; this one only draws patterns.
// Draws: support / resistance levels (touched 2+ times), double / triple tops and bottoms, head & shoulders (and inverse),
// rising / falling wedges, ascending / descending / symmetrical triangles, and candle patterns (engulfing, pin bar,
// morning / evening star, harami). A solid line is the neckline; when price closes through it a "break" label appears.
// Patterns are rule based and not proven to make money. Use them as a second opinion, with a stop loss.
indicator("FX Patterns", shorttitle="FX Patterns", overlay=true, max_lines_count=300, max_labels_count=300, max_bars_back=500)

G1 = "Patterns"
len     = input.int(5, "Swing length (bars on each side of a turning point)", minval=2, maxval=20, group=G1)
tolInp  = input.float(0.35, "Equal-level tolerance (x ATR)", minval=0.1, step=0.05, group=G1)
showSR  = input.bool(true, "Support / resistance levels", group=G1)
showDT  = input.bool(true, "Double / triple tops and bottoms", group=G1)
showHS  = input.bool(true, "Head & shoulders (and inverse)", group=G1)
showWg  = input.bool(true, "Wedges (rising / falling)", group=G1)
showTr  = input.bool(true, "Triangles (ascending / descending / symmetrical)", group=G1)
showCd  = input.bool(true, "Candle patterns (engulfing, pin bar, stars, harami)", group=G1)

bullCol = color.new(color.teal, 0)
bearCol = color.new(color.red, 0)
neutCol = color.new(color.orange, 0)

float atr = ta.atr(14)
float ph = ta.pivothigh(high, len, len)
float pl = ta.pivotlow(low, len, len)

var array<float> hP = array.new_float()
var array<int> hI = array.new_int()
var array<float> lP = array.new_float()
var array<int> lI = array.new_int()
var array<float> srP = array.new_float()
var array<int> srN = array.new_int()
var array<line> srLn = array.new_line()
var array<label> srLb = array.new_label()
var float actNeck = na
var int actSide = 0
var string actName = ""
bool patBuy = false
bool patSell = false

f_minLow(int i1, int i2) =>
    float v = low[bar_index - i1]
    for k = i1 to i2
        v := math.min(v, low[bar_index - k])
    v

f_maxHigh(int i1, int i2) =>
    float v = high[bar_index - i1]
    for k = i1 to i2
        v := math.max(v, high[bar_index - k])
    v

f_tag(int x, float y, string txt, int side) =>
    label.new(x, y, txt, xloc=xloc.bar_index, style=side == 1 ? label.style_label_up : side == -1 ? label.style_label_down : label.style_label_center, color=side == 1 ? bullCol : side == -1 ? bearCol : neutCol, textcolor=color.white, size=size.small)

f_neck(int x1, float y, int side) =>
    line.new(x1, y, bar_index, y, xloc=xloc.bar_index, color=side == 1 ? bullCol : bearCol, width=2)

f_addPivot(array<float> pa, array<int> ia, float p, int i) =>
    array.push(pa, p)
    array.push(ia, i)
    if array.size(pa) > 8
        array.shift(pa)
        array.shift(ia)
    true

f_redrawSR() =>
    for ln in srLn
        line.delete(ln)
    array.clear(srLn)
    for lb in srLb
        label.delete(lb)
    array.clear(srLb)
    int n = array.size(srP)
    if n > 0
        // draw the 6 levels nearest to the price that were touched at least twice
        for k = 0 to n - 1
            float p = array.get(srP, k)
            int t = array.get(srN, k)
            if t >= 2 and math.abs(p - close) <= 12 * atr
                color c = p < close ? color.new(color.teal, 30) : color.new(color.red, 30)
                array.push(srLn, line.new(bar_index - 150, p, bar_index + 5, p, xloc=xloc.bar_index, color=c, style=line.style_dashed, width=1))
                array.push(srLb, label.new(bar_index + 5, p, (p < close ? "Support x" : "Resistance x") + str.tostring(t), xloc=xloc.bar_index, style=label.style_label_left, color=c, textcolor=color.white, size=size.tiny))
    true

f_srTouch(float p) =>
    bool found = false
    int n = array.size(srP)
    if n > 0
        for k = 0 to n - 1
            float q = array.get(srP, k)
            if not found and math.abs(q - p) <= 0.5 * atr
                int t = array.get(srN, k)
                array.set(srP, k, (q * t + p) / (t + 1))
                array.set(srN, k, t + 1)
                found := true
    if not found
        array.push(srP, p)
        array.push(srN, 1)
        if array.size(srP) > 20
            array.shift(srP)
            array.shift(srN)
    true

// ------------------------------------------------------------------ new swing high
if not na(ph)
    f_addPivot(hP, hI, ph, bar_index - len)
    if showSR
        f_srTouch(ph)
        f_redrawSR()
    int n = array.size(hP)
    if n >= 2 and showDT
        float a1 = array.get(hP, n - 2)
        float a2 = array.get(hP, n - 1)
        int j1 = array.get(hI, n - 2)
        int j2 = array.get(hI, n - 1)
        if math.abs(a1 - a2) <= tolInp * atr and j2 - j1 >= 4 and bar_index - j1 < 300
            float neck = f_minLow(j1, j2)
            if math.max(a1, a2) - neck >= 1.5 * atr
                bool triple = false
                if n >= 3
                    float a0 = array.get(hP, n - 3)
                    triple := math.abs(a0 - a2) <= tolInp * atr and math.abs(a0 - a1) <= tolInp * atr
                f_neck(j1, neck, -1)
                actNeck := neck
                actSide := -1
                actName := triple ? "Triple Top" : "Double Top"
                f_tag(j2, a2, triple ? "Triple Top" : "Double Top", -1)
                patSell := true
    if n >= 3 and showHS
        float s1 = array.get(hP, n - 3)
        float s2 = array.get(hP, n - 2)
        float s3 = array.get(hP, n - 1)
        int k1 = array.get(hI, n - 3)
        int k2 = array.get(hI, n - 2)
        int k3 = array.get(hI, n - 1)
        if s2 > s1 + 0.5 * atr and s2 > s3 + 0.5 * atr and math.abs(s1 - s3) <= 0.4 * (s2 - math.min(s1, s3)) and bar_index - k1 < 300
            float neck = (f_minLow(k1, k2) + f_minLow(k2, k3)) / 2
            f_neck(k1, neck, -1)
            actNeck := neck
            actSide := -1
            actName := "Head & Shoulders"
            f_tag(k2, s2, "Head & Shoulders", -1)
            patSell := true

// ------------------------------------------------------------------ new swing low
if not na(pl)
    f_addPivot(lP, lI, pl, bar_index - len)
    if showSR
        f_srTouch(pl)
        f_redrawSR()
    int n = array.size(lP)
    if n >= 2 and showDT
        float a1 = array.get(lP, n - 2)
        float a2 = array.get(lP, n - 1)
        int j1 = array.get(lI, n - 2)
        int j2 = array.get(lI, n - 1)
        if math.abs(a1 - a2) <= tolInp * atr and j2 - j1 >= 4 and bar_index - j1 < 300
            float neck = f_maxHigh(j1, j2)
            if neck - math.min(a1, a2) >= 1.5 * atr
                bool triple = false
                if n >= 3
                    float a0 = array.get(lP, n - 3)
                    triple := math.abs(a0 - a2) <= tolInp * atr and math.abs(a0 - a1) <= tolInp * atr
                f_neck(j1, neck, 1)
                actNeck := neck
                actSide := 1
                actName := triple ? "Triple Bottom" : "Double Bottom"
                f_tag(j2, a2, triple ? "Triple Bottom" : "Double Bottom", 1)
                patBuy := true
    if n >= 3 and showHS
        float s1 = array.get(lP, n - 3)
        float s2 = array.get(lP, n - 2)
        float s3 = array.get(lP, n - 1)
        int k1 = array.get(lI, n - 3)
        int k2 = array.get(lI, n - 2)
        int k3 = array.get(lI, n - 1)
        if s2 < s1 - 0.5 * atr and s2 < s3 - 0.5 * atr and math.abs(s1 - s3) <= 0.4 * (math.max(s1, s3) - s2) and bar_index - k1 < 300
            float neck = (f_maxHigh(k1, k2) + f_maxHigh(k2, k3)) / 2
            f_neck(k1, neck, 1)
            actNeck := neck
            actSide := 1
            actName := "Inverse Head & Shoulders"
            f_tag(k2, s2, "Inverse H&S", 1)
            patBuy := true

// ------------------------------------------------------------------ wedges and triangles (checked on every new swing point)
if (not na(ph) or not na(pl)) and (showWg or showTr) and array.size(hP) >= 3 and array.size(lP) >= 3
    int nh = array.size(hP)
    int nl = array.size(lP)
    float h1 = array.get(hP, nh - 3)
    float h3 = array.get(hP, nh - 1)
    int hi1 = array.get(hI, nh - 3)
    int hi3 = array.get(hI, nh - 1)
    float l1 = array.get(lP, nl - 3)
    float l3 = array.get(lP, nl - 1)
    int li1 = array.get(lI, nl - 3)
    int li3 = array.get(lI, nl - 1)
    int st = math.min(hi1, li1)
    int en = math.max(hi3, li3)
    if en - st >= 15 and en - st <= 150 and hi3 > hi1 and li3 > li1 and bar_index - en <= len + 2
        float sh = (h3 - h1) / (hi3 - hi1)
        float sl = (l3 - l1) / (li3 - li1)
        float w0 = (h1 + sh * (st - hi1)) - (l1 + sl * (st - li1))
        float w1 = (h3 + sh * (en - hi3)) - (l3 + sl * (en - li3))
        bool converging = w1 > 0.25 * atr and w1 < 0.85 * w0
        string nm = ""
        int side = 0
        if showWg and converging and sh > 0 and sl > 1.2 * sh
            nm := "Rising Wedge"
            side := -1
        if showWg and converging and sh < 0 and sl < 0 and math.abs(sh) > 1.2 * math.abs(sl)
            nm := "Falling Wedge"
            side := 1
        bool flatHi = math.abs(h3 - h1) <= tolInp * atr * 1.5
        bool flatLo = math.abs(l3 - l1) <= tolInp * atr * 1.5
        if showTr and nm == "" and converging
            if flatHi and sl > 0 and sl * (en - st) >= 0.8 * atr
                nm := "Ascending Triangle"
                side := 1
            else if flatLo and sh < 0 and math.abs(sh) * (en - st) >= 0.8 * atr
                nm := "Descending Triangle"
                side := -1
            else if sh < 0 and sl > 0
                nm := "Symmetrical Triangle"
                side := 0
        if nm != ""
            color c = side == 1 ? bullCol : side == -1 ? bearCol : neutCol
            int x2 = bar_index
            line.new(st, h1 + sh * (st - hi1), x2, h1 + sh * (x2 - hi1), xloc=xloc.bar_index, color=c, width=2)
            line.new(st, l1 + sl * (st - li1), x2, l1 + sl * (x2 - li1), xloc=xloc.bar_index, color=c, width=2)
            f_tag(en, side == -1 ? h3 : l3, nm, side)
            if side == 1
                patBuy := true
            if side == -1
                patSell := true

// ------------------------------------------------------------------ neckline break
if actSide != 0 and barstate.isconfirmed
    if actSide == -1 and close < actNeck
        f_tag(bar_index, high, actName + " break", -1)
        actSide := 0
    else if actSide == 1 and close > actNeck
        f_tag(bar_index, low, actName + " break", 1)
        actSide := 0

// ------------------------------------------------------------------ candle patterns
float body = math.abs(close - open)
float rng = high - low
bool bullC = close > open
bool bearC = close < open
bool bullEng = showCd and bearC[1] and bullC and close >= open[1] and open <= close[1] and body >= 0.8 * atr
bool bearEng = showCd and bullC[1] and bearC and close <= open[1] and open >= close[1] and body >= 0.8 * atr
bool pinBull = showCd and rng >= 0.8 * atr and (math.min(open, close) - low) / rng >= 0.6 and body / rng <= 0.3
bool pinBear = showCd and rng >= 0.8 * atr and (high - math.max(open, close)) / rng >= 0.6 and body / rng <= 0.3
bool mStar = showCd and bearC[2] and math.abs(close[2] - open[2]) >= 0.6 * atr and math.abs(close[1] - open[1]) <= 0.3 * math.abs(close[2] - open[2]) and bullC and close > (open[2] + close[2]) / 2
bool eStar = showCd and bullC[2] and math.abs(close[2] - open[2]) >= 0.6 * atr and math.abs(close[1] - open[1]) <= 0.3 * math.abs(close[2] - open[2]) and bearC and close < (open[2] + close[2]) / 2
bool harBull = showCd and bearC[1] and math.abs(close[1] - open[1]) >= 0.8 * atr and bullC and open > close[1] and close < open[1] and body < math.abs(close[1] - open[1])
bool harBear = showCd and bullC[1] and math.abs(close[1] - open[1]) >= 0.8 * atr and bearC and open < close[1] and close > open[1] and body < math.abs(close[1] - open[1])

plotshape(bullEng, "Bullish engulfing", shape.triangleup, location.belowbar, bullCol, text="Eng", textcolor=bullCol, size=size.tiny)
plotshape(bearEng, "Bearish engulfing", shape.triangledown, location.abovebar, bearCol, text="Eng", textcolor=bearCol, size=size.tiny)
plotshape(pinBull and not bullEng, "Bullish pin bar", shape.triangleup, location.belowbar, bullCol, text="Pin", textcolor=bullCol, size=size.tiny)
plotshape(pinBear and not bearEng, "Bearish pin bar", shape.triangledown, location.abovebar, bearCol, text="Pin", textcolor=bearCol, size=size.tiny)
plotshape(mStar, "Morning star", shape.triangleup, location.belowbar, bullCol, text="Star", textcolor=bullCol, size=size.tiny)
plotshape(eStar, "Evening star", shape.triangledown, location.abovebar, bearCol, text="Star", textcolor=bearCol, size=size.tiny)
plotshape(harBull and not bullEng, "Bullish harami", shape.triangleup, location.belowbar, bullCol, text="Hrm", textcolor=bullCol, size=size.tiny)
plotshape(harBear and not bearEng, "Bearish harami", shape.triangledown, location.abovebar, bearCol, text="Hrm", textcolor=bearCol, size=size.tiny)

alertcondition(patBuy or bullEng or mStar, "FX Patterns bullish", "FX Patterns: bullish pattern on {{ticker}} {{interval}}")
alertcondition(patSell or bearEng or eStar, "FX Patterns bearish", "FX Patterns: bearish pattern on {{ticker}} {{interval}}")
